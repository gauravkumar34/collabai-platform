datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  USER
  ADMIN
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

enum OutboxStatus {
  PENDING
  PUBLISHED
  FAILED
}

// ─── Auth ────────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(uuid())
  email     String   @unique           // @unique already creates an index
  password  String
  name      String?
  role      Role     @default(USER)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshTokens   RefreshToken[]
  ownedWorkspaces Workspace[]       @relation("WorkspaceOwner")
  memberships     WorkspaceMember[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique           // SHA-256 hash — @unique already creates an index
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  family     String
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedBy String?                   // id of the token that replaced this one (audit chain)

  createdAt DateTime @default(now())
  userAgent String?
  ipAddress String?

  @@map("refresh_tokens")
  @@index([userId])
  @@index([family])
  @@index([expiresAt])                  // fast purge of expired tokens
  @@index([revokedAt])                  // fast purge of revoked tokens
}

// ─── Workspace ───────────────────────────────────────────────────────────────

model Workspace {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  ownerId     String
  owner       User     @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members WorkspaceMember[]

  @@map("workspaces")
  @@index([ownerId])
}

model WorkspaceMember {
  id          String        @id @default(uuid())
  workspaceId String
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        WorkspaceRole @default(MEMBER)
  joinedAt    DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@map("workspace_members")
  @@index([userId])
}

// ─── Outbox (Phase 9) ────────────────────────────────────────────────────────

model OutboxEvent {
  id          String       @id @default(uuid())
  aggregateId String
  eventType   String
  topic       String
  payload     Json
  status      OutboxStatus @default(PENDING)
  attempts    Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  publishedAt DateTime?

  @@map("outbox_events")
  @@index([status, createdAt])
}
